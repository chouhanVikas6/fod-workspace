{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zoid FOD Desktop",
  "version": "1.0.0",
  "identifier": "com.zoid.fod-desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist/renderer",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zoid Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/fod-backend"],
    "resources": [],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
