{
  "name": "fod-desktop-tauri",
  "version": "1.0.0",
  "private": true,
  "description": "Zoid FOD Desktop — Tauri v2 shell + Node sidecar (migration from fod-desktop Electron app, see ../docs/electron-to-tauri-migration-plan.md)",
  "scripts": {
    "dev:renderer": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "cross-env WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1 GDK_BACKEND=x11 tauri",
    "dev": "npm run tauri dev",
    "build": "npm run build:renderer && npm run tauri build"
  },
  "license": "ISC",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.18",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@tauri-apps/api": "~2.11.1",
    "@turf/turf": "^7.3.5",
    "bcryptjs": "^3.0.3",
    "classnames": "^2.5.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "geolib": "^3.3.14",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.72.0",
    "mapbox-gl": "^3.26.0",
    "msgpack-lite": "^0.1.26",
    "pg": "^8.22.0",
    "react-icons": "^5.7.0",
    "react-input-slider": "^6.0.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "react-slick": "^0.31.0",
    "react-toastify": "^11.1.0",
    "react-window": "^2.2.7",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0",
    "slick-carousel": "^1.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "supercluster": "^8.0.1"
  }
