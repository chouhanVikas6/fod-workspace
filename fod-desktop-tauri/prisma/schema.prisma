datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Mission {
  id           BigInt            @id @default(dbgenerated())
  status       MissionStatus     @default(ACTIVE)
  timer        Float             @default(0) // Use Float for a more precise numeric type
  scanStatus   MissionScanStatus @default(PAUSE)
  pass         Int?
  speed        Int?
  createdAt    DateTime
  updatedAt    DateTime          @updatedAt
  createdBy    String?
  updatedBy    String?
  dirty        Boolean?          @default(false) // New field for tracking changes
  previousTime DateTime?         @default(now())
}

model FodGroup {
  id             String         @id @default(uuid()) // Use uuid() for autogenerated unique id
  groupId        Int
  missionId      BigInt
  status         FodGroupStatus @default(NEW)
  biggestFodId   String?         @unique
  biggestFodSize Int?
  dirty          Boolean?       @default(false) // New field for tracking changes
  version        BigInt         @default(0)
  createdAt      DateTime
  updatedAt      DateTime       @updatedAt

  @@unique([groupId, missionId]) // Ensures uniqueness constraint on groupId and missionId
}

model Fod {
  id         String    @id @default(uuid()) // UUID as the primary key
  sysid      String? // Optional sysid
  location   Json // JSON type for location data
  confidence Float? // Optional confidence value
  timestamp  DateTime // Timestamp for the event
  class      String? // Optional class field
  velocity   Float // Double precision for velocity
  size       Float // Double precision for size
  missionId  BigInt
  groupId    Int
  dirty      Boolean?  @default(false) // New field for tracking changes
  createdAt  DateTime
  updatedAt  DateTime  @updatedAt
  fodGroupId String?

  @@index([groupId, missionId]) // Index on groupId and missionId to optimize queries
}

model ClearedFod {
  id             String           @id @default(uuid())
  status         ClearedFodStatus
  beforeClearImg String[]         @default([])
  afterClearImg  String[]         @default([])
  location       Json
  groupId        Int
  missionId      BigInt
  createdAt      DateTime
  updatedAt      DateTime         @updatedAt
  createdBy      String?
  updatedBy      String?
  dirty          Boolean?         @default(false) // New field for tracking changes

  @@unique([groupId, missionId])
  @@index([missionId, groupId]) // Optional: Index on missionId if frequently queried
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  firstName String
  lastName  String
  password  String
  isActive  Boolean  @default(true)
  role      Role     @default(COLLECTOR)
  dirty     Boolean? @default(false)
  createdAt DateTime
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  GUEST
  COLLECTOR
  DRIVER
}

enum MissionStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum MissionScanStatus {
  PLAY
  PAUSE
}

enum FodGroupStatus {
  NEW
  ACCEPTED
  REJECTED
  CLEARED
}

enum ClearedFodStatus {
  found
  not_found
  false_positive
}
